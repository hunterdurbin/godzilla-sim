#!/bin/bash
# Regenerate the trigger map if any effect scripts were modified.

TRIGGER_MAP="scripts/effects/trigger_map.gd"

# Check if any staged files are effect scripts or the base CardEffect class
if git diff --cached --name-only | grep -qE '^scripts/effects/'; then
	bash scripts/effects/generate_trigger_map.sh
	git add "$TRIGGER_MAP"
fi

# Ratchet: no new calls into scripts/core + scripts/effects private methods.
if git diff --cached --name-only | grep -qE '\.gd$|engine_private_calls_allowlist\.txt$'; then
	python3 scripts/tools/check_engine_private_calls.py || exit 1
fi

# Ratchet: per-card scripts don't re-check play-zone legality (5.11.1.1).
if git diff --cached --name-only | grep -qE '^scripts/effects/.*\.gd$|card_monster_zone_checks_allowlist\.txt$'; then
	python3 scripts/tools/check_card_monster_zone_checks.py || exit 1
fi

# Guard: per-card scripts mutate state only through engine primitives.
if git diff --cached --name-only | grep -qE '^scripts/effects/.*\.gd$'; then
	python3 scripts/tools/check_card_mutations.py || exit 1
fi

# Guard: engine sites that start a card ability call note_effect_resolving.
if git diff --cached --name-only | grep -qE '^scripts/effects/[^/]+\.gd$'; then
	python3 scripts/tools/check_effect_resolution_notes.py || exit 1
fi

# Guard: per-card scripts await every engine coroutine they call.
if git diff --cached --name-only | grep -qE '^scripts/effects/.*\.gd$'; then
	python3 scripts/tools/check_card_unawaited_coroutines.py || exit 1
fi

# Guard: no array literal reaches an Array[T] param through bind/Variant call.
if git diff --cached --name-only | grep -qE '\.gd$'; then
	python3 scripts/tools/check_typed_array_dynamic_calls.py || exit 1
fi

if git diff --cached --name-only | grep -qE '\.gd$'; then
	python3 scripts/tools/check_player_input_contract.py || exit 1
fi

# Guard: only the trigger dispatcher builds StandbyEntry objects.
if git diff --cached --name-only | grep -qE '^scripts/.*\.gd$'; then
	python3 scripts/tools/check_standby_entry_builders.py || exit 1
fi

# Ratchet: no new GDScript compile warnings (needs a Godot binary: set
# GODOT_BIN, or have `godot` on PATH; skipped otherwise — CI still runs it).
if git diff --cached --name-only | grep -qE '\.gd$|gdscript_warnings_allowlist\.txt$'; then
	GD_BIN="${GODOT_BIN:-$(command -v godot)}"
	if [ -n "$GD_BIN" ]; then
		python3 scripts/tools/check_gdscript_warnings.py "$GD_BIN" || exit 1
	else
		echo "pre-commit: GODOT_BIN unset, skipping check_gdscript_warnings.py (CI runs it)"
	fi
fi

# Sync version from project.godot into export_presets.cfg
if git diff --cached --name-only | grep -qE '^project\.godot$'; then
	if git diff --cached project.godot | grep -qE '^\+config/version='; then
		bash githooks/sync-version.sh
		git add export_presets.cfg
	fi
fi
