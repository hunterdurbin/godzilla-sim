// Shin Combo — Win Paths & Bot Strategy
// Render: dot -Tpng shin-combo-paths.dot -o shin-combo-paths.png
// Or:     dot -Tsvg shin-combo-paths.dot -o shin-combo-paths.svg

digraph ShinCombo {
    rankdir=TB
    bgcolor="white"
    fontname="Helvetica"
    node [fontname="Helvetica", fontsize=11]
    edge [fontname="Helvetica", fontsize=9]

    // ========== STYLES ==========
    node [shape=box, style="rounded,filled"]

    // ========== START ==========
    start [label="Bot's Turn\nMonster at Zone N", shape=ellipse, fillcolor="#b3d9ff", style=filled]

    // ========== DECK CHECK ==========
    deck_check [label="Deck has combo pieces?\n(advance-to-6 + advancement\n+ 2-step invasion)", shape=diamond, fillcolor="#fff3cd"]
    no_combo [label="Shin combo disabled\n(normal play)", fillcolor="#d4edda"]
    start -> deck_check
    deck_check -> no_combo [label="No"]

    // ========== RANK CHECK ==========
    rank_check [label="Rank >= 4?", shape=diamond, fillcolor="#fff3cd"]
    rank4_abandon [label="Rank 4+: Abandon combo\nSwitch to normal\ncounter/invasion play", fillcolor="#d4edda"]
    deck_check -> rank_check [label="Yes"]
    rank_check -> rank4_abandon [label="Yes\n(can't counter-retreat\nto rank 3)"]

    // ========== CYCLING ==========
    cycling_check [label="Partial state +\ncounter-retreat path?\nOpp below z7?", shape=diamond, fillcolor="#fff3cd"]
    cycle [label="CYCLE HAND\nGain rage (discard monster)\nDraw at end of turn\nDig for combo pieces", fillcolor="#cce5ff"]
    rank_check -> cycling_check [label="No"]
    cycling_check -> cycle [label="Yes\n(need pieces)"]

    // ========== PIECE CHECK ==========
    piece_check [label="Combo state?", shape=diamond, fillcolor="#fff3cd"]
    cycling_check -> piece_check [label="No\n(have pieces\nor opp at z7+)"]

    partial [label="PARTIAL STATE\nProtect from discard:\n• Invasion card\n• Advancement card\n• Advance-to-6 card\n\nScore penalty:\n• Invasion card: -100\n• Strategies ≤2: -80\n\nInvasion: NOT blocked\n1-step preferred", fillcolor="#ffeeba"]
    piece_check -> partial [label="Partial"]

    // ========== TEMPO CONTROL ==========
    subgraph cluster_tempo {
        label="Tempo Control"
        style="dashed,rounded"
        color="#6c757d"
        fontsize=12
        bgcolor="#f8f9fa"

        tempo [label="Invasion Suppression\n━━━━━━━━━━━━━━━\n• Never invade 1+ zone ahead of opp\n• Suppress at z5+ until opp at z7\n• Save 2-step cards (use 1-step)\n• Cap at z6 when opp at z7+\n• Only invade for counter-bait\n  or execution", fillcolor="#e8f4fd"]
    }

    // ========== EXECUTION GATE ==========
    exec_gate [label="Execution ready?\n• Viability > 0\n• Bot below z8\n• Opp at z6+ or z8 card\n• Bot at z6+ if opp at z7+", shape=diamond, fillcolor="#fff3cd"]
    piece_check -> exec_gate [label="Full"]
    exec_gate -> partial [label="Not ready\n(wait)"]

    // ========== PATH A: DIRECT SELF-ADVANCE ==========
    subgraph cluster_pathA {
        label="PATH A: Direct Self-Advance"
        style="dashed,rounded"
        color="#0066cc"
        fontsize=12
        bgcolor="#f0f8ff"

        zone_check [label="Monster zone?", shape=diamond, fillcolor="#fff3cd"]

        card1 [label="Play Card #1\n(advance to zone 6)\n━━━━━━━━━━━━\nEBP01-078 (best)\nEBP02-014 (RNG)\nEBP03-035 (column)", fillcolor="#d4edda"]
        at_z6 [label="Monster at Zone 6", fillcolor="#b3d9ff", shape=ellipse]

        card2 [label="Play Card #2\n(advance +1 zone)\n━━━━━━━━━━━━\nEBP02-003\nor advancement monster", fillcolor="#cce5ff"]
        at_z7 [label="Monster at Zone 7+", fillcolor="#b3d9ff", shape=ellipse]

        zone_check -> card1 [label="< 6"]
        zone_check -> at_z6 [label=">= 6\n(skip Card #1)"]
        card1 -> at_z6
        at_z6 -> card2
        card2 -> at_z7
    }
    exec_gate -> zone_check [label="Ready", penwidth=2, color="#0066cc"]

    // ========== PATH B: COUNTER-RETREAT ==========
    subgraph cluster_pathB {
        label="PATH B: Counter-Retreat (Bonus)"
        style="dashed,rounded"
        color="#e83e8c"
        fontsize=12
        bgcolor="#fdf2f8"

        opp_z7 [label="Opponent at zone 7+\nBot at zone 5-6", fillcolor="#f5c6cb"]
        bait [label="Bot invades to z6-7\n(counter-bait position)", fillcolor="#ffeeba"]
        countered [label="Opponent counters?", shape=diamond, fillcolor="#fff3cd"]
        no_counter [label="Not countered:\nContinue Path A", fillcolor="#d4edda"]

        retreat [label="Counter-retreat!\nBot retreats (z7→4, z6→5)\nBot ranks up to rank 3", fillcolor="#f5c6cb"]
        rankup_effect [label="Rank 3 monster on_enter:\nAdvance opponent +1 zone\n(z7 → z8)\n━━━━━━━━━━━━━━━━\nCRUSHES opponent's\nz8 battle card!", fillcolor="#e83e8c", fontcolor=white]

        opp_z7 -> bait -> countered
        countered -> no_counter [label="No"]
        countered -> retreat [label="Yes"]
        retreat -> rankup_effect
    }

    // ========== PHASE 3: CLEAR + INVADE ==========
    subgraph cluster_win {
        label="Win Phase: Clear Z8 + Invade"
        style="dashed,rounded"
        color="#28a745"
        fontsize=12
        bgcolor="#f0fff0"

        z8_check [label="Opponent z8\nhas battle card?", shape=diamond, fillcolor="#fff3cd"]
        z8_clear [label="Z8 clear!\n(crushed by counter-retreat\nor already empty)", fillcolor="#d4edda"]
        destroy [label="Play destroy card", fillcolor="#f5c6cb"]
        invade [label="INVADE 2-STEP\nZ7 → Z8 → Z9", fillcolor="#28a745", fontcolor=white, style="rounded,filled,bold"]
        victory [label="VICTORY!", shape=doubleoctagon, fillcolor="#28a745", fontcolor=white, style=filled]
    }

    at_z7 -> z8_check [penwidth=2, color="#0066cc"]
    rankup_effect -> z8_clear [label="Z8 crushed\nby opponent's\nown monster", penwidth=2, color="#e83e8c"]

    z8_check -> z8_clear [label="No"]
    z8_check -> destroy [label="Yes"]
    destroy -> z8_clear
    z8_clear -> invade [penwidth=2, color="#28a745"]
    invade -> victory [penwidth=2, color="#28a745"]

    // ========== RANK-UP SELECTION ==========
    subgraph cluster_rankup {
        label="Rank-Up Selection (on counter)"
        style="rounded"
        color="#6c757d"
        fontsize=12
        bgcolor="#f8f9fa"
        node [shape=plaintext, fillcolor=white]

        rankup_table [label=<
<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6">
  <TR>
    <TD BGCOLOR="#343a40"><FONT COLOR="white"><B>Factor</B></FONT></TD>
    <TD BGCOLOR="#343a40"><FONT COLOR="white"><B>Condition</B></FONT></TD>
    <TD BGCOLOR="#343a40"><FONT COLOR="white"><B>Score</B></FONT></TD>
  </TR>
  <TR><TD>Base</TD><TD>Monster rank</TD><TD>rank * 10</TD></TR>
  <TR><TD>Threat</TD><TD>Threat level</TD><TD>threat / 1000</TD></TR>
  <TR><TD BGCOLOR="#e83e8c"><FONT COLOR="white">Combo</FONT></TD><TD BGCOLOR="#e83e8c"><FONT COLOR="white">advances_opponent + opp z7+</FONT></TD><TD BGCOLOR="#e83e8c"><FONT COLOR="white"><B>+200</B></FONT></TD></TR>
  <TR><TD>Combo</TD><TD>advances_opponent + opp z5-6</TD><TD>+50</TD></TR>
  <TR><TD>Tags</TD><TD>destroys_zone</TD><TD>+20</TD></TR>
  <TR><TD>Tags</TD><TD>boosts_threat + rage &gt;= 2</TD><TD>+15</TD></TR>
</TABLE>
        >]
    }

    // ========== VIABILITY SCORING ==========
    subgraph cluster_viability {
        label="Viability Score (Full State)"
        style="rounded"
        color="#6c757d"
        fontsize=12
        bgcolor="#f8f9fa"
        node [shape=plaintext, fillcolor=white]

        viability_table [label=<
<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6">
  <TR>
    <TD BGCOLOR="#343a40"><FONT COLOR="white"><B>Factor</B></FONT></TD>
    <TD BGCOLOR="#343a40"><FONT COLOR="white"><B>Condition</B></FONT></TD>
    <TD BGCOLOR="#343a40"><FONT COLOR="white"><B>Score</B></FONT></TD>
  </TR>
  <TR><TD>Proximity</TD><TD>Zone 3</TD><TD>+50</TD></TR>
  <TR><TD>Proximity</TD><TD>Zone 4</TD><TD>+70</TD></TR>
  <TR><TD>Proximity</TD><TD>Zone 5</TD><TD>+90</TD></TR>
  <TR><TD>Proximity</TD><TD BGCOLOR="#d4edda">Zone 6</TD><TD BGCOLOR="#d4edda"><B>+100</B></TD></TR>
  <TR><TD BGCOLOR="#e83e8c"><FONT COLOR="white">Counter-retreat</FONT></TD><TD BGCOLOR="#e83e8c"><FONT COLOR="white">Opp z7+ with CR path</FONT></TD><TD BGCOLOR="#e83e8c"><FONT COLOR="white"><B>+30</B></FONT></TD></TR>
  <TR><TD>Opp Pressure</TD><TD>Opp z1-4</TD><TD>+20</TD></TR>
  <TR><TD>Opp Pressure</TD><TD>Opp z7 (no CR)</TD><TD>-20</TD></TR>
  <TR><TD>Z8 Clear</TD><TD>No destroy needed</TD><TD>+20</TD></TR>
  <TR><TD>Hand</TD><TD>5+ remaining</TD><TD>-5</TD></TR>
  <TR><TD>Hand</TD><TD>0 remaining</TD><TD>-20</TD></TR>
  <TR><TD>CP Gap</TD><TD>&gt;= 10000 behind</TD><TD>-30</TD></TR>
  <TR><TD BGCOLOR="#f8d7da">Blocked</TD><TD BGCOLOR="#f8d7da">Invasion blocked</TD><TD BGCOLOR="#f8d7da"><B>-100</B></TD></TR>
</TABLE>
        >]
    }

    // ========== LEGEND ==========
    subgraph cluster_legend {
        label="Legend"
        style="rounded"
        color="#6c757d"
        fontsize=12
        bgcolor="#f8f9fa"
        node [shape=plaintext, fillcolor=white]

        legend [label=<
<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="4" CELLPADDING="4">
  <TR><TD BGCOLOR="#28a745"><FONT COLOR="white"> Win / Victory </FONT></TD>
      <TD BGCOLOR="#cce5ff"> Key combo card </TD>
      <TD BGCOLOR="#d4edda"> Good / Viable </TD></TR>
  <TR><TD BGCOLOR="#ffeeba"> Conditional / Wait </TD>
      <TD BGCOLOR="#f5c6cb"> Counter / Destroy </TD>
      <TD BGCOLOR="#f8d7da"> Blocked / Bad </TD></TR>
  <TR><TD BGCOLOR="#b3d9ff"> Zone state </TD>
      <TD BGCOLOR="#fff3cd"> Decision point </TD>
      <TD BGCOLOR="#e83e8c"><FONT COLOR="white"> Counter-retreat </FONT></TD></TR>
</TABLE>
        >]
    }
}
