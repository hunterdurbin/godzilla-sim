root = true

[*]
charset = utf-8
insert_final_newline = true

# GDScript: tabs, matching the Godot editor default and the existing codebase.
[*.gd]
indent_style = tab
indent_size = 4

[*.py]
indent_style = space
indent_size = 4

[*.{yml,yaml}]
indent_style = space
indent_size = 2

[*.sh]
indent_style = space
indent_size = 4
