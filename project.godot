; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Unofficial Godzilla Sim"
config/version="0.1.11-release-hotfix.1"
run/main_scene="res://scenes/ui/LoadingScreen.tscn"
config/quit_on_go_back=false
config/features=PackedStringArray("4.6", "GL Compatibility")
boot_splash/bg_color=Color(0, 0, 0, 1)
boot_splash/show_image=false
boot_splash/stretch_mode=0
boot_splash/image="res://assets/icons/game_icon.png"
config/icon="res://assets/icons/game_icon.png"

[autoload]

CardData="*res://data/card_data.gd"
ArtworkDownloader="*res://scripts/artwork_downloader.gd"
DecklistManager="*res://data/decklist_manager.gd"
NetworkManager="*res://scripts/network_manager.gd"
GameSettings="*res://data/game_settings.gd"
StatsUploader="*res://scripts/stats_uploader.gd"
UpdateChecker="*res://scripts/update_checker.gd"
RpcLogger="*res://scripts/rpc_logger.gd"
TouchHelper="*res://scripts/touch_helper.gd"
SfxManager="*res://scripts/sfx_manager.gd"
MusicManager="*res://scripts/music_manager.gd"

[debug]

file_logging/enable_file_logging=true
file_logging/log_path="user://crash_logs/godot.log"
file_logging/max_log_files=10

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/mode.mobile="canvas_items"
window/stretch/aspect.mobile="expand"

[editor_plugins]

enabled=PackedStringArray()

[gui]

theme/custom="res://assets/fonts/default_theme.tres"

[input_devices]

pointing/android/enable_pan_and_scale_gestures=true
pointing/emulate_touch_from_mouse.mobile=true

[internationalization]

locale/translations=PackedStringArray("res://translations/strings.en.translation", "res://translations/strings.ja.translation", "res://translations/cards.en.translation", "res://translations/cards.ja.translation")

[physics]

3d/physics_engine="Jolt Physics"

[rendering]

rendering_device/driver.windows="d3d12"
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
